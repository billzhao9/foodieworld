{
  "name": "foodieworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "vue-tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@reactor-team/js-sdk": "3.0.2",
    "dotenv": "17.3.1",
    "hls.js": "1.7.3",
    "hono": "4.13.11",
    "lucide-vue-next": "0.577.0",
    "pg": "8.20.0",
    "vue": "3.5.43",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "25.5.0",
    "@types/pg": "8.18.0",
    "@vitejs/plugin-vue": "6.0.5",
    "concurrently": "9.2.1",
    "esbuild": "0.27.7",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.3",
    "vitest": "4.1.0",
    "vue-tsc": "3.2.6"
  },
  "engines": {
    "node": ">=22.12"
  }
}
