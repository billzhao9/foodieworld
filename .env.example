MMLONE_BASE_URL=http://127.0.0.1:3000
MMLONE_API_KEY=
MMLONE_ENVIRONMENT=development
# 本地和云端使用同一个数据库；本地可通过 SSH 隧道连接。
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:15432/foodieworld
# 留空会在首次启动时生成，保存到 .data/access.json
APP_PASSWORD=
APP_SESSION_SECRET=
PORT=4174
HOST=0.0.0.0
# HTTPS 部署时设置 true
SECURE_COOKIES=false
# Production: NODE_ENV=production forces secure cookies and HTTPS upstream.
NODE_ENV=development
# Use mmlone for server-side enterprise speech; macOS local voice is the development default.
NARRATION_PROVIDER=local
